<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!--
            Employee Income Statement
    -->
        <record id="view_isy_employee_income_statement_tree" model="ir.ui.view">
            <field name="name">Employee Income Statement</field>
            <field name="model">employee.income.statement</field>
            <field name="arch" type="xml">
                <tree string="Employee Income Statement" create="false">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="employee_id"/>
                    <field name="isy_amount" widget="monetary"/>
                    <field name="gty_amount" widget="monetary"/>
                    <field name="tax_amount" widget="monetary"/>
                    <field name="gross_amount" widget="monetary"/>
                    <field name="net_amount" widget="monetary"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'check'"/>
                </tree>
            </field>
        </record>

        <record id="view_employee_income_statement_search" model="ir.ui.view">
            <field name="name">employee.income.statement.search</field>
            <field name="model">employee.income.statement</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="employee_tag_ids" string="Tags"/>
                    <group expand="0" string="Group By">
                        <filter string="Name" name="group_by_name" context="{'group_by': 'name'}"/>
                        <filter string="Tags" name="group_by_tags" context="{'group_by': 'employee_tag_ids'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_isy_employee_income_statement_form" model="ir.ui.view">
            <field name="name">Employee Income Statement</field>
            <field name="model">employee.income.statement</field>
            <field name="arch" type="xml">
                <form string="Employee Income Statement" create="false">
                    <header>
                        <button name="btn_check" string="Check" type="object"
                                class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <button name="btn_draft" string="Draft" type="object"
                                class="oe_highlight"
                                invisible="state != 'check'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,check"/>
                    </header>

                    <sheet>
                        <h1>
                            <field name="employee_id" readonly="1"/>
                        </h1>
                        <group>
                            <field name="employee_tag_ids" widget="many2many_tags"/>
                            <field name="name" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <group>
                                <field name="isy_amount"/>
                                <field name="gty_amount"/>
                                <field name="tax_amount"/>
                            </group>
                            <group>
                                <field name="gross_amount"/>
                                <field name="net_amount"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <record id="action_isy_employee_income_statement" model="ir.actions.act_window">
            <field name="name">Employee Income Statement</field>
            <field name="res_model">employee.income.statement</field>
            <field name="view_id" ref="view_isy_employee_income_statement_tree"/>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_employee_income_statement_search"/>
        </record>

        <menuitem id="menu_isy_employee_income_statement" name="Employee Income Statement" parent="menu_isy_employee_income_statement_root" action="action_isy_employee_income_statement" sequence="11"/>

    </data>
</odoo>
